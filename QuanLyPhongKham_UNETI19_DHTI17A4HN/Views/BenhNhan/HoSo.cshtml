@* Họ và tên: Trần Anh Đức - Mã sinh viên: 23103100284
   Nội dung thực hiện: Trang hồ sơ cá nhân của bệnh nhân - xem và cập nhật thông tin của chính mình. *@
@model BenhNhan
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}
<section class="page-hero">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item active">Hồ sơ cá nhân</li></ol></nav>
        <h1>Hồ sơ cá nhân</h1>
    </div>
</section>
<section class="section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card-soft p-4 text-center">
                    <span class="avatar-initial mx-auto mb-3" style="width:84px;height:84px;font-size:1.8rem">@GiaoDienHelper.ChuCaiDau(Model.HoTen)</span>
                    <h5 class="fw-bold mb-0">@Model.HoTen</h5>
                    <div class="text-muted small mb-3">Mã bệnh nhân: BN@(Model.MaBenhNhan.ToString("0000"))</div>
                    <div class="row g-2 mb-3">
                        <div class="col-6"><div class="p-2 rounded-3" style="background:#f4f7fb"><div class="fw-bold fs-5">@ViewBag.SoLichKham</div><div class="small text-muted">Lịch đã đặt</div></div></div>
                        <div class="col-6"><div class="p-2 rounded-3" style="background:#f4f7fb"><div class="fw-bold fs-5">@ViewBag.SoDaKham</div><div class="small text-muted">Lần đã khám</div></div></div>
                    </div>
                    <div class="small text-muted text-start">
                        <div class="mb-1"><i class="bi bi-person me-2"></i>Tài khoản: <strong>@Model.TaiKhoan?.TenDangNhap</strong></div>
                        <div><i class="bi bi-calendar3 me-2"></i>Đăng ký từ: @Model.NgayDangKy.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="d-grid gap-2 mt-3">
                        <a asp-controller="LichKham" asp-action="LichCuaToi" class="btn btn-soft"><i class="bi bi-calendar2-check me-1"></i>Lịch khám của tôi</a>
                        <a asp-controller="TaiKhoan" asp-action="DoiMatKhau" class="btn btn-light-border"><i class="bi bi-key me-1"></i>Đổi mật khẩu</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card-soft">
                    <div class="card-head"><h6>Cập nhật thông tin</h6></div>
                    <div class="card-body">
                        <form asp-action="HoSo" method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                            <partial name="_ThongTinCaNhan" model="Model" />
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Lưu hồ sơ</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
