@* Họ và tên: Trần Anh Đức - Mã sinh viên: 23103100284
   Nội dung thực hiện: Form thêm/sửa bệnh nhân (quản trị). *@
@model BenhNhan
@{ bool laSua = Model.MaBenhNhan > 0; }
<form asp-action="@(laSua ? "Edit" : "Create")" method="post" novalidate>
    <input type="hidden" asp-for="MaBenhNhan" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <h6 class="form-section"><i class="bi bi-person-vcard"></i>Thông tin cá nhân</h6>
    <partial name="_ThongTinCaNhan" model="Model" />
    <h6 class="form-section mt-4"><i class="bi bi-gear"></i>Quản lý</h6>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="GhiChu" class="form-label"></label>
            <textarea asp-for="GhiChu" rows="2" class="form-control" placeholder="Tiền sử dị ứng, bệnh nền..."></textarea>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <div class="form-check form-switch">
                <input asp-for="TrangThai" class="form-check-input" role="switch" />
                <label asp-for="TrangThai" class="form-check-label">Đang theo dõi</label>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light-border">Hủy</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>@(laSua ? "Lưu thay đổi" : "Thêm bệnh nhân")</button>
    </div>
</form>
