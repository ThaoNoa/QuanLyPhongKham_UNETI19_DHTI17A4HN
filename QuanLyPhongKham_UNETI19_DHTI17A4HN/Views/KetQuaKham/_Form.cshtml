@* Họ và tên: Trần Phương Thảo - Mã sinh viên: 23103100226
   Nội dung thực hiện: Form nhập/sửa kết quả khám - textarea cho chẩn đoán, kết luận, đơn thuốc, lời dặn, ghi chú;
   chọn dịch vụ y tế đã sử dụng và tự tính tổng tiền; hiển thị thông báo lỗi số lượng dịch vụ. *@
@model KetQuaKhamFormViewModel
@{
    bool laSua = Model.MaKetQua > 0;
    var l = Model.LichKham;
}
<form asp-action="@(laSua ? "Edit" : "Create")" method="post" novalidate>
    <input type="hidden" asp-for="MaKetQua" />
    <input type="hidden" asp-for="MaLichKham" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card-soft mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-4 small">
                        <div><div class="text-muted">Bệnh nhân</div><div class="fw-bold">@l?.BenhNhan?.HoTen</div><div class="text-muted">@l?.BenhNhan?.GioiTinh · @(l?.BenhNhan != null ? DateTime.Today.Year - l.BenhNhan.NgaySinh.Year : 0) tuổi</div></div>
                        <div><div class="text-muted">Ngày khám</div><div class="fw-bold">@l?.NgayKham.ToString("dd/MM/yyyy")</div><div class="text-muted">@l?.GioBatDau.ToString(@"hh\:mm") - @l?.GioKetThuc.ToString(@"hh\:mm")</div></div>
                        <div><div class="text-muted">Bác sĩ</div><div class="fw-bold">@l?.BacSi?.HoTen</div><div class="text-muted">@l?.BacSi?.ChuyenKhoa?.TenChuyenKhoa</div></div>
                        <div class="flex-grow-1"><div class="text-muted">Lý do khám</div><div class="fw-semibold">@l?.LyDoKham</div></div>
                    </div>
                </div>
            </div>
            <div class="card-soft">
                <div class="card-body">
                    <h6 class="form-section"><i class="bi bi-clipboard2-pulse"></i>Kết quả khám</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ChanDoan" class="form-label required"></label>
                            <textarea asp-for="ChanDoan" rows="2" class="form-control" placeholder="VD: Viêm họng cấp"></textarea>
                            <span asp-validation-for="ChanDoan"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="KetLuan" class="form-label required"></label>
                            <textarea asp-for="KetLuan" rows="2" class="form-control"></textarea>
                            <span asp-validation-for="KetLuan"></span>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="DonThuoc" class="form-label"></label>
                            <textarea asp-for="DonThuoc" rows="5" class="form-control" placeholder="Mỗi thuốc một dòng: tên thuốc - liều dùng - cách dùng"></textarea>
                            <span asp-validation-for="DonThuoc"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="LoiDan" class="form-label"></label>
                            <textarea asp-for="LoiDan" rows="5" class="form-control" placeholder="Chế độ ăn uống, nghỉ ngơi, lịch tái khám..."></textarea>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="GhiChu" class="form-label"></label>
                            <textarea asp-for="GhiChu" rows="2" class="form-control"></textarea>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="TrangThai" class="form-label"></label>
                            <select asp-for="TrangThai" class="form-select">
                                @foreach (TrangThaiKetQua t in Enum.GetValues<TrangThaiKetQua>())
                                {
                                    <option value="@t" selected="@(Model.TrangThai == t)">@t.TenHienThi()</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-soft position-sticky" style="top:80px">
                <div class="card-head"><h6><i class="bi bi-bag-plus text-primary me-1"></i>Dịch vụ sử dụng</h6></div>
                <div class="card-body" style="max-height:440px;overflow:auto">
                    @for (int i = 0; i < Model.DichVus.Count; i++)
                    {
                        var dv = Model.DichVus[i];
                        <div class="d-flex flex-wrap align-items-center gap-2 py-2 border-bottom dv-row" data-gia="@dv.DonGia.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <input type="hidden" asp-for="DichVus[i].MaDichVu" />
                            <input type="hidden" asp-for="DichVus[i].TenDichVu" />
                            <input type="hidden" asp-for="DichVus[i].DonViTinh" />
                            <input type="hidden" name="DichVus[@i].DonGia" value="@dv.DonGia.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <div class="form-check flex-grow-1 mb-0">
                                <input asp-for="DichVus[i].DaChon" class="form-check-input dv-chon" />
                                <label class="form-check-label small" for="DichVus_@(i)__DaChon"><span class="fw-semibold">@dv.TenDichVu</span><br /><span class="text-muted">@dv.DonGia.DinhDangTien() / @dv.DonViTinh</span></label>
                            </div>
                            <input asp-for="DichVus[i].SoLuong" type="number" min="1" max="100" class="form-control form-control-sm dv-sl" style="width:64px;padding:.3rem .4rem" />
                            <span asp-validation-for="DichVus[i].SoLuong" class="w-100 text-end small"></span>
                        </div>
                    }
                </div>
                <div class="card-body border-top d-flex justify-content-between align-items-center">
                    <span class="text-muted">Tổng tiền dịch vụ</span><strong class="fs-5 text-primary" id="tongTien">0 đ</strong>
                </div>
                <div class="card-body pt-0 d-grid gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>@(laSua ? "Lưu thay đổi" : "Lưu kết quả")</button>
                    <a href="javascript:history.back()" class="btn btn-light-border">Hủy</a>
                </div>
            </div>
        </div>
    </div>
</form>
