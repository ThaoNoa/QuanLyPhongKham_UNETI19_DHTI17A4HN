@* Họ và tên: Trần Phương Thảo - Mã sinh viên: 23103100226
   Nội dung thực hiện: Phiếu kết quả khám - bệnh nhân/bác sĩ/nhân viên xem theo quyền, có thể in. *@
@model KetQuaKham
@{
    ViewData["Title"] = "Kết quả khám";
    ViewData["Subtitle"] = $"{Model.LichKham?.BenhNhan?.HoTen} · {Model.LichKham?.NgayKham:dd/MM/yyyy}";
    Layout = Context.Session.LayoutTheoVaiTro();
    bool admin = Layout == "_AdminLayout";
    var l = Model.LichKham;
    var bn = l?.BenhNhan;
}
@if (!admin)
{
    <section class="page-hero no-print">
        <div class="container">
            <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item"><a asp-controller="LichKham" asp-action="LichCuaToi">Lịch khám của tôi</a></li><li class="breadcrumb-item active">Kết quả khám</li></ol></nav>
            <h1>Kết quả khám</h1>
        </div>
    </section>
}
<div class="@(admin ? "" : "container section")" style="max-width:920px">
    <div class="d-flex justify-content-end gap-2 mb-3 no-print">
        @if (admin)
        {
            <a asp-action="Edit" asp-route-id="@Model.MaKetQua" class="btn btn-light-border"><i class="bi bi-pencil me-1"></i>Sửa</a>
        }
        <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i>In phiếu</button>
    </div>
    <div class="result-sheet">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 pb-3 mb-3 border-bottom">
            <div class="brand"><partial name="_Logo" /><div><div class="brand-name">PhongKhamCare</div><div class="brand-sub">123 Nguyễn Văn Cừ, Long Biên, Hà Nội · 1900 1234</div></div></div>
            <div class="text-end">
                <h4 class="fw-bold mb-0">PHIẾU KẾT QUẢ KHÁM</h4>
                <div class="small text-muted">Số: KQ@(Model.MaKetQua.ToString("00000")) · <span class="@Model.TrangThai.CssTrangThai()">@Model.TrangThai.TenHienThi()</span></div>
            </div>
        </div>
        <div class="row g-3 small mb-3">
            <div class="col-md-6">
                <div><span class="text-muted">Họ tên:</span> <strong>@bn?.HoTen</strong></div>
                <div><span class="text-muted">Giới tính / Ngày sinh:</span> @bn?.GioiTinh · @bn?.NgaySinh.ToString("dd/MM/yyyy")</div>
                <div><span class="text-muted">Số BHYT:</span> @(bn?.SoBHYT ?? "Không có")</div>
            </div>
            <div class="col-md-6">
                <div><span class="text-muted">Ngày khám:</span> <strong>@l?.NgayKham.ToString("dd/MM/yyyy")</strong> (@l?.GioBatDau.ToString(@"hh\:mm") - @l?.GioKetThuc.ToString(@"hh\:mm"))</div>
                <div><span class="text-muted">Bác sĩ:</span> @l?.BacSi?.HocVi.TenVietTat() @l?.BacSi?.HoTen</div>
                <div><span class="text-muted">Chuyên khoa:</span> @l?.BacSi?.ChuyenKhoa?.TenChuyenKhoa</div>
            </div>
        </div>
        <div class="mb-3"><div class="small text-muted mb-1">Lý do khám</div><div>@l?.LyDoKham</div></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6"><div class="small text-muted mb-1">Chẩn đoán</div><div class="fw-semibold">@Model.ChanDoan</div></div>
            <div class="col-md-6"><div class="small text-muted mb-1">Kết luận</div><div>@Model.KetLuan</div></div>
        </div>
        <div class="mb-3"><div class="small text-muted mb-1"><i class="bi bi-capsule me-1"></i>Đơn thuốc</div><div class="rx">@(string.IsNullOrWhiteSpace(Model.DonThuoc) ? "Không kê đơn" : Model.DonThuoc)</div></div>
        <div class="mb-3"><div class="small text-muted mb-1"><i class="bi bi-chat-heart me-1"></i>Lời dặn của bác sĩ</div><div class="rx">@(Model.LoiDan ?? "—")</div></div>

        <div class="small text-muted mb-1">Dịch vụ sử dụng</div>
        <table class="table table-sm align-middle">
            <thead><tr><th>Dịch vụ</th><th class="text-center">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var c in Model.ChiTietDichVus)
                {
                    <tr><td>@c.DichVuYTe?.TenDichVu</td><td class="text-center">@c.SoLuong @c.DichVuYTe?.DonViTinh</td><td class="text-end">@c.DonGia.DinhDangTien()</td><td class="text-end">@((c.SoLuong * c.DonGia).DinhDangTien())</td></tr>
                }
                @if (!Model.ChiTietDichVus.Any()) { <tr><td colspan="4" class="text-muted">Không sử dụng dịch vụ.</td></tr> }
            </tbody>
            <tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th class="text-end text-primary">@Model.TongTien.DinhDangTien()</th></tr></tfoot>
        </table>
        @if (!string.IsNullOrEmpty(Model.GhiChu)) { <div class="small"><span class="text-muted">Ghi chú:</span> @Model.GhiChu</div> }
        <div class="d-flex justify-content-between mt-4 small">
            <div class="text-muted">Cập nhật: @Model.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="text-center"><div class="fw-semibold">Bác sĩ khám bệnh</div><div style="height:48px"></div><div class="fw-bold">@l?.BacSi?.HoTen</div></div>
        </div>
    </div>
</div>
