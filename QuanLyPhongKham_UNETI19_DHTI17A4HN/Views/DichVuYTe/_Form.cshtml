@* Họ và tên: Trần Phương Thảo - Mã sinh viên: 23103100226
   Nội dung thực hiện: Form thêm/sửa dịch vụ y tế. *@
@model DichVuYTe
@{ bool laSua = Model.MaDichVu > 0; }
<form asp-action="@(laSua ? "Edit" : "Create")" method="post" novalidate>
    <input type="hidden" asp-for="MaDichVu" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="TenDichVu" class="form-label required"></label>
            <input asp-for="TenDichVu" class="form-control" />
            <span asp-validation-for="TenDichVu"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DonViTinh" class="form-label required"></label>
            <input asp-for="DonViTinh" class="form-control" list="dsDonVi" />
            <datalist id="dsDonVi"><option>Lần</option><option>Phim</option><option>Mũi</option><option>Hàm</option><option>Gói</option></datalist>
            <span asp-validation-for="DonViTinh"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DonGia" class="form-label required"></label>
            <input asp-for="DonGia" type="number" min="0" step="1000" class="form-control" asp-format="{0:0}" />
            <span asp-validation-for="DonGia"></span>
        </div>
        <div class="col-12">
            <label asp-for="MoTa" class="form-label"></label>
            <textarea asp-for="MoTa" rows="3" class="form-control"></textarea>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="TrangThai" class="form-check-input" role="switch" />
                <label asp-for="TrangThai" class="form-check-label">Đang áp dụng</label>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light-border">Hủy</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>@(laSua ? "Lưu thay đổi" : "Thêm dịch vụ")</button>
    </div>
</form>
