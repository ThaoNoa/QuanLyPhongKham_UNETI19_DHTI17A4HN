@* Họ và tên: Lê Quang Trung - Mã sinh viên: 23103100270
   Nội dung thực hiện: Trang chi tiết bác sĩ (quản trị). *@
@model BacSiChiTietViewModel
@{
    var b = Model.BacSi;
    ViewData["Title"] = "Chi tiết bác sĩ";
    ViewData["Subtitle"] = b.HoTen;
    Layout = "_AdminLayout";
}
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-soft p-4 text-center h-100">
            <partial name="_AnhBacSi" model="b" view-data='new ViewDataDictionary(ViewData) { ["css"] = "mx-auto mb-3" }' />
            <h5 class="fw-bold mb-1">@b.HocVi.TenVietTat() @b.HoTen</h5>
            <div class="text-muted mb-2">@b.ChuyenKhoa?.TenChuyenKhoa</div>
            @if (b.TrangThai) { <span class="status status-active">Đang nhận lịch</span> } else { <span class="status status-inactive">Tạm ngừng</span> }
            <div class="row g-2 mt-3">
                <div class="col-6"><div class="p-2 rounded-3" style="background:#f4f7fb"><div class="fw-bold fs-5">@Model.SoLuotKham</div><div class="small text-muted">Lượt đã khám</div></div></div>
                <div class="col-6"><div class="p-2 rounded-3" style="background:#f4f7fb"><div class="fw-bold fs-5">@Model.SoLichSapToi</div><div class="small text-muted">Lịch sắp tới</div></div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card-soft h-100">
            <div class="card-head"><h6>Thông tin bác sĩ</h6></div>
            <div class="card-body">
                <dl class="info-list">
                    <dt>Mã bác sĩ</dt><dd>#@b.MaBacSi</dd>
                    <dt>Ngày sinh</dt><dd>@b.NgaySinh.ToString("dd/MM/yyyy") (@(DateTime.Today.Year - b.NgaySinh.Year) tuổi)</dd>
                    <dt>Giới tính</dt><dd>@b.GioiTinh</dd>
                    <dt>Học vị</dt><dd>@b.HocVi.TenHienThi()</dd>
                    <dt>Chuyên môn</dt><dd>@b.ChuyenMon</dd>
                    <dt>Số điện thoại</dt><dd>@b.SoDienThoai</dd>
                    <dt>Email</dt><dd>@b.Email</dd>
                    <dt>Tài khoản</dt><dd>@(b.TaiKhoan != null ? b.TaiKhoan.TenDangNhap : "Chưa gán")</dd>
                    <dt>Ghi chú</dt><dd>@(b.GhiChu ?? "—")</dd>
                </dl>
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-light-border">Quay lại</a>
                    <a asp-controller="TiepNhan" asp-action="Index" asp-route-tuKhoa="@b.HoTen" class="btn btn-soft"><i class="bi bi-calendar2-week me-1"></i>Xem lịch khám</a>
                    <a asp-action="Edit" asp-route-id="@b.MaBacSi" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Sửa</a>
                </div>
            </div>
        </div>
    </div>
</div>
