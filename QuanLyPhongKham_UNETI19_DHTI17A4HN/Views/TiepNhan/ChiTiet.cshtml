@* Họ và tên: Đỗ Huy Tùng - Mã sinh viên: 23103100296
   Nội dung thực hiện: Chi tiết lịch khám (quản trị/bác sĩ) - tiến trình trạng thái, thông tin lịch, bệnh nhân,
   các lần khám trước; nút quay lại trang trước. *@
@model LichKham
@{
    ViewData["Title"] = $"Lịch khám #LK{Model.MaLichKham:00000}";
    ViewData["Subtitle"] = $"{Model.BenhNhan?.HoTen} · {Model.NgayKham:dd/MM/yyyy}";
    Layout = "_AdminLayout";
    var vaiTro = Context.Session.LayVaiTro();
    bool laQuanTri = vaiTro == VaiTro.Admin || vaiTro == VaiTro.NhanVien;
    var lichSu = ViewBag.LichSu as List<LichKham> ?? new();
}
<div class="card-soft p-4 mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="flex-grow-1" style="max-width:560px"><partial name="~/Views/LichKham/_TienTrinh.cshtml" model="Model.TrangThai" /></div>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card-soft h-100">
            <div class="card-head"><h6>Thông tin lịch khám</h6><span class="@Model.TrangThai.CssTrangThai()">@Model.TrangThai.TenHienThi()</span></div>
            <div class="card-body">
                <dl class="info-list">
                    <dt>Ngày khám</dt><dd>@GiaoDienHelper.TenThu(Model.NgayKham), @Model.NgayKham.ToString("dd/MM/yyyy")</dd>
                    <dt>Thời gian</dt><dd>@Model.GioBatDau.ToString(@"hh\:mm") - @Model.GioKetThuc.ToString(@"hh\:mm")</dd>
                    <dt>Bác sĩ</dt><dd>@Model.BacSi?.HocVi.TenVietTat() @Model.BacSi?.HoTen @if (Model.BacSi?.TrangThai == false) { <span class="status status-inactive ms-1">Tạm ngừng</span> }</dd>
                    <dt>Chuyên khoa</dt><dd>@Model.BacSi?.ChuyenKhoa?.TenChuyenKhoa · Phòng @Model.BacSi?.ChuyenKhoa?.SoPhong</dd>
                    <dt>Lý do khám</dt><dd>@Model.LyDoKham</dd>
                    <dt>Ghi chú</dt><dd>@(Model.GhiChu ?? "—")</dd>
                    <dt>Ngày đặt</dt><dd>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card-soft mb-3">
            <div class="card-head"><h6>Bệnh nhân</h6>@if (laQuanTri) { <a asp-controller="BenhNhan" asp-action="Details" asp-route-id="@Model.MaBenhNhan" class="small">Xem hồ sơ</a> }</div>
            <div class="card-body">
                <div class="person d-flex align-items-center gap-2 mb-3">
                    <span class="avatar-initial" style="width:44px;height:44px">@GiaoDienHelper.ChuCaiDau(Model.BenhNhan?.HoTen)</span>
                    <div><div class="fw-bold">@Model.BenhNhan?.HoTen</div><div class="small text-muted">@Model.BenhNhan?.GioiTinh · @(Model.BenhNhan != null ? DateTime.Today.Year - Model.BenhNhan.NgaySinh.Year : 0) tuổi</div></div>
                </div>
                <div class="small"><i class="bi bi-telephone me-2 text-muted"></i>@Model.BenhNhan?.SoDienThoai</div>
                <div class="small mt-1"><i class="bi bi-credit-card-2-front me-2 text-muted"></i>BHYT: @(Model.BenhNhan?.SoBHYT ?? "Không có")</div>
            </div>
        </div>
        <div class="card-soft">
            <div class="card-head"><h6>Lần khám trước</h6></div>
            <div class="card-body py-2">
                @if (!lichSu.Any()) { <div class="small text-muted py-2">Chưa có lần khám trước.</div> }
                <ul class="rank-list">
                    @foreach (var x in lichSu)
                    {
                        <li><i class="bi bi-clipboard2-check text-success"></i><div class="small"><div class="fw-semibold">@x.NgayKham.ToString("dd/MM/yyyy")</div><div class="text-muted">@x.BacSi?.HoTen · @x.LyDoKham</div></div></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
<a href="javascript:history.back()" class="btn btn-light-border mt-3"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
