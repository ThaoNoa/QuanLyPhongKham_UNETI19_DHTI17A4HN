@* Họ và tên: Trần Phương Thảo - Mã sinh viên: 23103100226
   Nội dung thực hiện: Cấu hình Chart.js dùng chung (font, màu lưới, định dạng tiền VNĐ, tooltip). *@
<script src="~/lib/chartjs/chart.umd.min.js"></script>
<script>
    Chart.defaults.font.family = '"Be Vietnam Pro", system-ui, sans-serif';
    Chart.defaults.font.size = 12;
    Chart.defaults.color = '#64748b';
    Chart.defaults.plugins.tooltip.backgroundColor = '#15233f';
    Chart.defaults.plugins.tooltip.padding = 10;
    Chart.defaults.plugins.tooltip.cornerRadius = 8;
    Chart.defaults.plugins.tooltip.displayColors = false;
    window.pkTien = v => Number(v).toLocaleString('vi-VN') + ' đ';
    window.pkTienGon = v => v >= 1e6 ? (v / 1e6).toLocaleString('vi-VN', { maximumFractionDigits: 1 }) + ' tr' : v >= 1e3 ? (v / 1e3) + 'k' : v;
    window.pkThang = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'];
    window.pkLuoi = { color: '#eef2f7', drawTicks: false };
</script>
