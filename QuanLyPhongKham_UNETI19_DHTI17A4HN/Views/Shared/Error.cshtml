@* Họ và tên: Trần Phương Thảo (Nhóm trưởng) - Mã sinh viên: 23103100226
   Nội dung thực hiện: Trang thông báo lỗi hệ thống. *@
@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}
<section class="section">
    <div class="container" style="max-width:560px">
        <div class="card-soft text-center p-5">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width:76px;height:76px;background:#fff5e0;color:#b76e00;font-size:2rem"><i class="bi bi-exclamation-triangle"></i></div>
            <h3 class="fw-bold">Đã có lỗi xảy ra</h3>
            <p class="text-muted">Hệ thống gặp sự cố khi xử lý yêu cầu. Vui lòng thử lại sau.</p>
            @if (Model?.ShowRequestId == true) { <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p> }
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Về trang chủ</a>
        </div>
    </div>
</section>
