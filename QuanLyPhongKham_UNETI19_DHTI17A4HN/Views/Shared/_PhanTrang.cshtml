@* Họ và tên: Lê Quang Trung - Mã sinh viên: 23103100270
   Nội dung thực hiện: Thanh phân trang dùng chung - mỗi link trang giữ nguyên tham số tìm kiếm/lọc/sắp xếp. *@
@model PhanTrangViewModel
@{
    int batDau = Math.Max(1, Model.TrangHienTai - 2);
    int ketThuc = Math.Min(Model.TongSoTrang, Model.TrangHienTai + 2);
    string? controller = Model.Controller ?? ViewContext.RouteData.Values["controller"]?.ToString();
}
@if (Model.TongSoTrang > 1)
{
    <nav aria-label="Phân trang">
        <ul class="pagination">
            <li class="page-item @(Model.TrangHienTai <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="@controller" asp-action="@Model.Action" asp-all-route-data="@Model.ThamSoTrang(1)" title="Trang đầu"><i class="bi bi-chevron-double-left"></i></a>
            </li>
            <li class="page-item @(Model.TrangHienTai <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="@controller" asp-action="@Model.Action" asp-all-route-data="@Model.ThamSoTrang(Model.TrangHienTai - 1)" title="Trang trước"><i class="bi bi-chevron-left"></i></a>
            </li>
            @if (batDau > 1)
            {
                <li class="page-item disabled"><span class="page-link">…</span></li>
            }
            @for (int i = batDau; i <= ketThuc; i++)
            {
                <li class="page-item @(i == Model.TrangHienTai ? "active" : "")">
                    <a class="page-link" asp-controller="@controller" asp-action="@Model.Action" asp-all-route-data="@Model.ThamSoTrang(i)">@i</a>
                </li>
            }
            @if (ketThuc < Model.TongSoTrang)
            {
                <li class="page-item disabled"><span class="page-link">…</span></li>
            }
            <li class="page-item @(Model.TrangHienTai >= Model.TongSoTrang ? "disabled" : "")">
                <a class="page-link" asp-controller="@controller" asp-action="@Model.Action" asp-all-route-data="@Model.ThamSoTrang(Model.TrangHienTai + 1)" title="Trang sau"><i class="bi bi-chevron-right"></i></a>
            </li>
            <li class="page-item @(Model.TrangHienTai >= Model.TongSoTrang ? "disabled" : "")">
                <a class="page-link" asp-controller="@controller" asp-action="@Model.Action" asp-all-route-data="@Model.ThamSoTrang(Model.TongSoTrang)" title="Trang cuối"><i class="bi bi-chevron-double-right"></i></a>
            </li>
        </ul>
    </nav>
}
