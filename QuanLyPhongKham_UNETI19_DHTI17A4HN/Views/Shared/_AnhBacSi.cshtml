@model BacSi
@{
    var css = ViewData["css"] as string ?? "";
}
@if (!string.IsNullOrEmpty(Model.HinhAnh))
{
    <img src="@Model.HinhAnh" alt="@Model.HoTen" class="doctor-photo @css" loading="lazy" />
}
else
{
    <div class="doctor-photo initials @css">@GiaoDienHelper.ChuCaiDau(Model.HoTen)</div>
}
